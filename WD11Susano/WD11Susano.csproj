    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(SlManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Pooling">
      <HintPath>$(SlManaged)\Pooling.dll</HintPath>
