      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(SlManaged)\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SlManaged)\UnityEngine.CoreModule.dll</HintPath>
